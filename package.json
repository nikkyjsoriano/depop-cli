{
  "name": "depop-cli",
  "version": "0.1.1",
  "description": "Drive your logged-in Depop session from the terminal. Capture a browser session, replay it against Depop's unofficial API. JSON in, JSON out, agent-ready.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikkyjsoriano/depop-cli.git"
  },
  "homepage": "https://github.com/nikkyjsoriano/depop-cli#readme",
  "bugs": "https://github.com/nikkyjsoriano/depop-cli/issues",
  "keywords": [
    "depop",
    "cli",
    "agents",
    "skills",
    "unofficial-api",
    "resell"
  ],
  "bin": {
    "depop": "bin/depop.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "spec/",
    "skills/",
    "extension/",
    "docs/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "typecheck:ext": "tsc --noEmit -p extension/tsconfig.json",
    "test": "bun test",
    "build": "bun build packages/cli/src/bin.ts --target=bun --outdir dist",
    "prepack": "bun run build",
    "depop": "bun run packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.1.42",
    "typescript": "^6.0.3"
  }
}
