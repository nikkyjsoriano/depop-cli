{
  "manifest_version": 3,
  "name": "depop cli",
  "version": "0.1.0",
  "description": "Captures your Depop browser session for the depop CLI and posts a minimal credential bundle to its local receiver.",
  "permissions": ["tabs", "cookies", "webRequest", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "action": {
    "default_title": "depop cli",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content-localhost.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-app.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
